generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  password     String
  createdAt    DateTime      @default(now())
  avatars      Avatar[]
  avatarVideos AvatarVideo[]
  refreshToken RefreshToken[]
}
model RefreshToken {
   id          Int        @id @default(autoincrement())
   userId      String
   tokenHash   String     @unique
   expireAt    DateTime
   revokedAt   DateTime?
   createdAt   DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Avatar {
  id             String                 @id @default(uuid())
  userId         String
  name           String
  user           User                   @relation(fields: [userId], references: [id])
  avatarImage    AvatarImage[]
  avatarVideoRef AvatarVideoReference[]
}

model AvatarImage {
  id       String          @id @default(uuid())
  avatarId String
  type     AvatarImageType
  url      String
  avatar   Avatar          @relation(fields: [avatarId], references: [id])
}

enum AvatarImageType {
  user
  model
}

model AvatarVideo {
  id             String                 @id @default(uuid())
  userId         String
  prompt         String
  startframe     String?
  endframe       String?
  videoUrl       String
  duration       Int
  width          Int
  height         Int
  status         AvatarVideoStatus
  avatarVideoRef AvatarVideoReference[]
  user           User                   @relation(fields: [userId], references: [id])
}

model AvatarVideoReference {
  id            String      @id @default(uuid())
  avatarVideoId String
  avatarId      String
  avatar        Avatar      @relation(fields: [avatarId], references: [id])
  avatarVideo   AvatarVideo @relation(fields: [avatarVideoId], references: [id])
}

enum AvatarVideoStatus {
  Pending
  Done
  Error
}
